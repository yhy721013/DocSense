# 这份文件集成所有环境变量，不再需要在运行系统前使用 Powershell 加载 $env
# 如何使用：将文件名改为 .env，然后将填写【被注释的必填项】

# ============================================
# AnythingLLM 配置
# ============================================
# AnythingLLM 的开发商的API Key
# ###############这一项必须填写################
# ANYTHINGLLM_API_KEY=WF2P6W5-1DK41R7-JF10A8H-F381F8P
# AnythingLLM 默认连接配置
ANYTHINGLLM_BASE_URL=http://localhost:3001/api/v1
# 请求超时（秒）（可选）
ANYTHINGLLM_TIMEOUT=
# AnythingLLM storage 根目录（可选）
ANYTHINGLLM_STORAGE_ROOT=

# ============================================
# APP 配置
# ============================================
# 应用的监听地址和端口
APP_HOST=0.0.0.0
APP_PORT=5001
APP_DEBUG=true

# ============================================
# LLM 知识抽取模式配置
# ============================================
# /llm/analysis 领域分类模式：
# topk_two_stage（默认，两阶段分类与字段抽取）
# topk_single（保留 Top-K 候选的单阶段回滚模式）
# legacy（仅允许完整树候选不超过 128 且最终完整 Prompt 不超过 32000 字符的小树）
# 显式空值或未知值会导致服务拒绝启动
DOCSENSE_ANALYSIS_CLASSIFICATION_MODE=topk_two_stage
# 1: 现有按 Chunk 提问模式  2: 按文件聚合提问模式
WEAPONRY_ANALYSE_MODE=2
# 是否启用术语规则辅助上下文；关闭后不检索术语 workspace，也不把术语规则加入 Prompt
WEAPONRY_TERMS_RULE_CONTEXT_ENABLED=true

# ============================================
# 文件存储配置
# ============================================
# 所有运行时文件的统一绝对根目录；Windows 推荐使用正斜杠
DOCSENSE_RUNTIME_DIR=C:/DocSenseRuntime
# 单次请求容量限制，单位：字节，默认 500MB
DOCSENSE_MAX_CONTENT_LENGTH=524288000
# 文件对话基础设施运行模式：当前只支持 single_instance。配置 cluster、
# external_dispatcher 或其他值时服务会在装配阶段拒绝启动，避免共享 SQLite 文件。
DOCSENSE_CHAT_RUNTIME_MODE=single_instance

# ============================================
# LLM 集成配置
# ============================================
# 甲方业务系统回调地址
# ###############这一项必须填写################
# CALLBACK_URL=http://127.0.0.1:9000/llm/callback
# 回调超时秒数，默认10秒
CALLBACK_TIMEOUT=10
# 文件下载超时秒数，默认60秒
FILE_DOWNLOAD_TIMEOUT=60
# 文件下载暂存目录默认使用 `${DOCSENSE_RUNTIME_DIR}/llm_downloads`

# ============================================
# 翻译模型配置
# ============================================
# 翻译使用的模型名称，默认使用 Qwen3-4B-Instruct-2507-Q4_K_M
DOCSENSE_TRANSLATION_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M
# 翻译模式：machine 使用 argostranslate 机器翻译；llm 使用 DOCSENSE_TRANSLATION_MODEL 指定的大模型翻译
DOCSENSE_TRANSLATION_MODE=machine
# 机器翻译模型目录
ARGOS_PACKAGES_DIR=D:\DocSense\argos-translate\packages

# ============================================
# OCR 配置
# ============================================
# 处理扫描版 PDF 时，是否自动进行 OCR 识别转换为 Markdown
DOCSENSE_OCR_ENABLED=true
# OCR 识别的语言，默认中文和英文
DOCSENSE_OCR_LANGUAGES=chi_sim+eng
# OCR 识别的DPI，默认300
DOCSENSE_OCR_DPI=300
# OCR 识别的抽样页数，默认3页
DOCSENSE_OCR_SAMPLE_PAGES=3
# OCR 识别的文本阈值，默认50
DOCSENSE_OCR_TEXT_THRESHOLD=50
# OCR 识别缓存默认使用 `${DOCSENSE_RUNTIME_DIR}/ocr_markdown`
# /llm/analysis 扫描 PDF 预处理引擎：mineru 或 ocr；report 等其他入口仍沿旧 OCR 预处理
DOCSENSE_ANALYSIS_SCANNED_PDF_ENGINE=mineru
# MinerU 缓存默认使用 `${DOCSENSE_RUNTIME_DIR}/mineru_markdown`
# MinerU 解析语言，默认中文
DOCSENSE_MINERU_LANG=ch
# 可选：复用外部 MinerU API；为空时沿本地 MinerU API 启动方式
DOCSENSE_MINERU_API_URL=
# Tesseract 语言包目录（如果 Tesseract 未正确安装或找不到语言包时需要手动指定）
TESSDATA_PREFIX=

# 任务库、知识库和对话库均默认保存在 DOCSENSE_RUNTIME_DIR 根目录

# ============================================
# Mock Callback Server 配置
# ============================================
# 模拟甲方回调接口的监听地址和端口
MOCK_CALLBACK_HOST=127.0.0.1 #使用docker的时候要改成0.0.0.0
MOCK_CALLBACK_PORT=9000

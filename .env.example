# 这份文件集成所有环境变量，不再需要在运行系统前使用 Powershell 加载 $env
# 如何使用：将文件名改为 .env，然后将填写【被注释的必填项】

# ============================================
# AnythingLLM 配置
# ============================================
# AnythingLLM 的开发商的API Key
# ###############这一项必须填写################
# ANYTHINGLLM_API_KEY=WF2P6W5-1DK41R7-JF10A8H-F381F8P
# AnythingLLM 默认连接配置
ANYTHINGLLM_BASE_URL=http://localhost:3001/api/v1
# 请求超时（秒）（可选）
ANYTHINGLLM_TIMEOUT=
# AnythingLLM storage 根目录（可选）
ANYTHINGLLM_STORAGE_ROOT=

# ============================================
# APP 配置
# ============================================
# 应用的监听地址和端口
APP_HOST=0.0.0.0
APP_PORT=5001
APP_DEBUG=true

# ============================================
# LLM 知识抽取模式配置
# ============================================
# 1: 现有按 Chunk 提问模式  2: 按文件聚合提问模式
WEAPONRY_ANALYSE_MODE=2
# 是否启用术语规则辅助上下文；关闭后不检索术语 workspace，也不把术语规则加入 Prompt
WEAPONRY_TERMS_RULE_CONTEXT_ENABLED=true

# ============================================
# 文件存储配置
# ============================================
# 正式 `/llm/*` 任务 SQLite 路径
DOCSENSE_LLM_TASK_DB=.runtime/llm_tasks.sqlite3
# 单次请求容量限制，单位：字节，默认 500MB
DOCSENSE_MAX_CONTENT_LENGTH=524288000

# ============================================
# LLM 集成配置
# ============================================
# 甲方业务系统回调地址
# ###############这一项必须填写################
# CALLBACK_URL=http://127.0.0.1:9000/llm/callback
# 回调超时秒数，默认10秒
CALLBACK_TIMEOUT=10
# 文件下载超时秒数，默认60秒
FILE_DOWNLOAD_TIMEOUT=60
# 甲方文件下载暂存目录，默认 `.runtime/llm_downloads`
FILE_DOWNLOAD_DIR=.runtime/llm_downloads

# ============================================
# 翻译模型配置
# ============================================
# 翻译使用的模型名称，默认使用 Qwen3-4B-Instruct-2507-Q4_K_M
DOCSENSE_TRANSLATION_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M

# ============================================
# OCR 配置
# ============================================
# 处理扫描版 PDF 时，是否自动进行 OCR 识别转换为 Markdown
DOCSENSE_OCR_ENABLED=true
# OCR 识别的语言，默认中文和英文
DOCSENSE_OCR_LANGUAGES=chi_sim+eng
# OCR 识别的DPI，默认300
DOCSENSE_OCR_DPI=300
# OCR 识别的抽样页数，默认3页
DOCSENSE_OCR_SAMPLE_PAGES=3
# OCR 识别的文本阈值，默认50
DOCSENSE_OCR_TEXT_THRESHOLD=50
# OCR 识别的缓存目录，默认 `.runtime/ocr_markdown`
DOCSENSE_OCR_CACHE_DIR=.runtime/ocr_markdown
# Tesseract 语言包目录（如果 Tesseract 未正确安装或找不到语言包时需要手动指定）
TESSDATA_PREFIX=

# ============================================
# 知识库配置
# ============================================
KNOWLEDGE_BASE_DB_PATH=.runtime/knowledge_base.sqlite3

# ============================================
# 对话记录配置
# ============================================
# 文件对话会话 SQLite 路径
DOCSENSE_CHAT_DB=.runtime/chat_sessions.sqlite3

# ============================================
# Mock Callback Server 配置
# ============================================
# 模拟甲方回调接口的监听地址和端口
MOCK_CALLBACK_HOST=127.0.0.1 #使用docker的时候要改成0.0.0.0
MOCK_CALLBACK_PORT=9000

# ============================================
# RAG 增强功能配置（BM25 + Embedding 双召回 + RRF + Reranker）
# ============================================
# 是否启用 RAG 增强功能，默认 false（保持原有行为）
RAG_ENHANCER_ENABLED=false
# BM25 检索返回的 Top-K 数量，默认 20
RAG_BM25_TOP_K=20
# Embedding 检索返回的 Top-K 数量，默认 20
RAG_EMBEDDING_TOP_K=20
# RRF 融合常数 k，通常取 60，默认 60
RAG_RRF_K=60
# 是否启用 BGE-Reranker 重排序，默认 true
RAG_RERANK_ENABLED=true
# Reranker 模型名称，默认 BAAI/bge-reranker-v2-m3
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Rerank 后返回的 Top-N 数量，默认 5
RAG_RERANK_TOP_N=5
# Rerank 批处理大小，默认 32
RAG_RERANK_BATCH_SIZE=32

# ============================================
# BM25 关键词提取优化配置
# ============================================
# 是否启用 BM25 关键词提取（停用词过滤、专业术语提取等），默认 true
RAG_BM25_KEYWORD_EXTRACTION=true
# 是否启用 LLM Query 重写（需要 Ollama 服务），默认 false（性能考虑）
RAG_LLM_QUERY_REWRITE=true
# LLM Query 重写使用的模型，默认 qwen3:4b-instruct-2507-q4_K_Mb
RAG_QUERY_REWRITE_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Ollama 服务地址，默认 http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

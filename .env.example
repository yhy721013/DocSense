# 这份文件集成所有环境变量，不再需要在运行系统前使用 Powershell 加载 $env
# 如何使用：将文件名改为 .env，然后将填写【被注释的必填项】

# ============================================
# AnythingLLM 配置
# ============================================
# AnythingLLM 的开发商的API Key
# ###############这一项必须填写################
# ANYTHINGLLM_API_KEY=WF2P6W5-1DK41R7-JF10A8H-F381F8P
# AnythingLLM 默认连接配置
ANYTHINGLLM_BASE_URL=http://localhost:3001/api/v1
# 请求超时（秒）（可选）
ANYTHINGLLM_TIMEOUT=
# AnythingLLM storage 根目录（可选）
ANYTHINGLLM_STORAGE_ROOT=

# ============================================
# APP 配置
# ============================================
# 应用的监听地址和端口
APP_HOST=0.0.0.0
APP_PORT=5001
APP_DEBUG=true

# ============================================
# LLM 知识抽取模式配置
# ============================================
# /llm/analysis 领域分类模式：
# topk_two_stage（默认，两阶段分类与字段抽取）
# topk_single（保留 Top-K 候选的单阶段回滚模式）
# legacy（仅允许完整树候选不超过 128 且最终完整 Prompt 不超过 32000 字符的小树）
# 显式空值或未知值会导致服务拒绝启动
DOCSENSE_ANALYSIS_CLASSIFICATION_MODE=topk_two_stage
# /llm/analysis 文件名分类约束：
# scope_guard（默认，启用简氏作用域识别与文件名/首页标题双源分支约束）
# legacy（即时回滚到既有文件名硬约束）
# 显式空值或未知值会导致服务拒绝启动
DOCSENSE_ANALYSIS_FILENAME_CONSTRAINT_MODE=scope_guard
# /llm/analysis 数据标准正文分类保护：
# scope_guard（默认；仅在文件名与首页共同确认标准正文后，将候选限制为数据标准六类叶子；
# 无法确认专业类别时定向归入“通用要求”，该叶子缺失则任务失败）
# legacy（即时回滚，保留既有候选召回）
# 显式空值或未知值会导致服务拒绝启动
DOCSENSE_ANALYSIS_DATA_STANDARD_MODE=scope_guard
# /llm/analysis 装备身份受限重选：
# off（即时回滚，不发起重选）
# shadow（满足严格双证据门禁时执行一次受限重选，但不采纳结果）
# enforce（默认；满足门禁且初次分类位于目标分支外或仅命中过粗祖先时，
# 仅在已确认装备父节点及其七类直属明细叶子中重选一次）
# 重选返回空值、非法节点或调用失败时保留初次分类；显式空值或未知值会导致服务拒绝启动
DOCSENSE_ANALYSIS_IDENTITY_RESELECT_MODE=enforce

# ============================================
# 武器谱固定策略与本地 Dispatcher 配置
# ============================================
# WEAPONRY_ANALYSE_MODE 已删除：新链固定 file_aggregate_v1，不再提供运行时模式选择。
# 迁移期环境中若仍显式存在值 1，应用会在任何任务副作用前拒绝装配。
DOCSENSE_WEAPONRY_RUNTIME_MODE=single_instance
DOCSENSE_WEAPONRY_SCAN_INTERVAL_SECONDS=1
# accepted batch 只是单次 SQLite 扫描页大小，不是业务积压上限。
DOCSENSE_WEAPONRY_ACCEPTED_BATCH_SIZE=50
DOCSENSE_WEAPONRY_DISPATCH_FAILURE_RETRY_SECONDS=30
DOCSENSE_WEAPONRY_MAINTENANCE_INTERVAL_SECONDS=30
DOCSENSE_WEAPONRY_MAINTENANCE_LIMIT=50
DOCSENSE_WEAPONRY_RUNNING_SAMPLE_LIMIT=20
DOCSENSE_WEAPONRY_STOP_TIMEOUT_SECONDS=5
DOCSENSE_WEAPONRY_CLEANUP_HTTP_TIMEOUT_SECONDS=60
DOCSENSE_WEAPONRY_CLEANUP_LEASE_SECONDS=130

# 以下四项必须填写为部署现场真实、稳定且可审计的能力标识；它们不是 URL 或密钥。
# 运行配置与 Adapter 声明不一致时会 fail-fast，不会在单次调用失败后更换策略。
# DOCSENSE_WEAPONRY_PROVIDER_FINGERPRINT=anythingllm-api-v1:<deployment-id>
# DOCSENSE_WEAPONRY_EMBEDDING_FINGERPRINT=<embedding-provider-and-model>
# DOCSENSE_WEAPONRY_DOCUMENT_PROCESSING_FINGERPRINT=<document-processing-profile>
# DOCSENSE_WEAPONRY_EXTRACTION_MODEL_FINGERPRINT=<extraction-provider-and-model>
# 真实供应商联调完成后填写只读证明文件；缺失时生产就绪度保持 false。
# DOCSENSE_WEAPONRY_PRODUCTION_ATTESTATION_PATH=runtime/weaponry-production-attestation.json
# 本地开发默认 false；生产/Docker 必须设为 true，使证明缺失、失效或过期时启动失败。
DOCSENSE_WEAPONRY_REQUIRE_PRODUCTION_GATE=false
DOCSENSE_WEAPONRY_QUERY_VERSION=field-semantic-v2
DOCSENSE_WEAPONRY_SCORE_SEMANTICS=higher-is-more-relevant-in-unit-interval
DOCSENSE_WEAPONRY_SCORE_PROTOCOL=explicit-unit-score-or-stable-rank-v2
DOCSENSE_WEAPONRY_RANKING_STRATEGY=score-desc-or-rank-asc-stable-v2
DOCSENSE_WEAPONRY_EXTRACTION_CONTEXT_STRATEGY=provided_evidence_model_v1
DOCSENSE_WEAPONRY_INPUT_CANDIDATE_TOP_N=8
DOCSENSE_WEAPONRY_TABLE_CANDIDATE_TOP_N=16
DOCSENSE_WEAPONRY_MAX_TABLE_ROWS=100
DOCSENSE_WEAPONRY_EXTRACTION_MAX_ATTEMPTS=2

# 术语辅助关闭时，组合根不会读取下面五个术语专属配置，也不会访问目录/workspace。
WEAPONRY_TERMS_RULE_CONTEXT_ENABLED=false
# WEAPONRY_TERMS_WORKSPACE_NAME=weaponry-terms-rules
# WEAPONRY_TERMS_DIR=terms
# WEAPONRY_TERMS_CATALOG_FINGERPRINT=<terms-catalog-version>
# DOCSENSE_WEAPONRY_TERMS_CANDIDATE_TOP_N=5
# DOCSENSE_WEAPONRY_TERMS_MAX_CONTEXT_CHARS=1200

# ============================================
# 文件存储配置
# ============================================
# 所有运行时文件的统一绝对根目录；Windows 推荐使用正斜杠
DOCSENSE_RUNTIME_DIR=C:/DocSenseRuntime
# 单次请求容量限制，单位：字节，默认 500MB
DOCSENSE_MAX_CONTENT_LENGTH=524288000
# 文件对话基础设施运行模式：当前只支持 single_instance。配置 cluster、
# external_dispatcher 或其他值时服务会在装配阶段拒绝启动，避免共享 SQLite 文件。
DOCSENSE_CHAT_RUNTIME_MODE=single_instance

# 报告 Dispatcher 当前同样只支持 single_instance。accepted 积压保存在 SQLite，
# 下列批量值只限制单次扫描工作量，不限制允许积压的任务总数。
DOCSENSE_REPORT_RUNTIME_MODE=single_instance
DOCSENSE_REPORT_SCAN_INTERVAL_SECONDS=1
DOCSENSE_REPORT_ACCEPTED_BATCH_SIZE=50
# 领取前基础设施异常的持久化冷却时间。不会限制正常积压数量；冷却中的坏任务会暂时
# 让出扫描首页，避免 CPU/日志热循环并保证后续 accepted 继续处理。
DOCSENSE_REPORT_DISPATCH_FAILURE_RETRY_SECONDS=30
DOCSENSE_REPORT_RESOURCE_SWEEP_INTERVAL_SECONDS=30
DOCSENSE_REPORT_RESOURCE_SWEEP_LIMIT=50
DOCSENSE_REPORT_RUNNING_SAMPLE_LIMIT=20
DOCSENSE_REPORT_STOP_TIMEOUT_SECONDS=5
# 仅用于 AnythingLLM 幂等 DELETE 清理；不改变报告生成/模型查询的全局超时。
# 清理租约必须严格大于单次清理 HTTP 超时，才能安全接管心跳过期的清理任务。
DOCSENSE_REPORT_CLEANUP_HTTP_TIMEOUT_SECONDS=60
DOCSENSE_REPORT_CLEANUP_LEASE_SECONDS=130

# 分类节点变更同步 Saga 当前只支持单实例；其 SQLite lease 使用进程本地时钟。
# 以下秒数均为内部有限预算，生产部署前仍须通过隔离供应商故障演练校准。
DOCSENSE_REASSIGN_RUNTIME_MODE=single_instance
DOCSENSE_REASSIGN_HTTP_TIMEOUT_SECONDS=15
DOCSENSE_REASSIGN_TOTAL_TIMEOUT_SECONDS=75
DOCSENSE_REASSIGN_COMPENSATION_RESERVE_SECONDS=30

# ============================================
# LLM 集成配置
# ============================================
# 甲方业务系统回调地址
# ###############这一项必须填写################
# CALLBACK_URL=http://127.0.0.1:9000/llm/callback
# 回调超时秒数，默认10秒
CALLBACK_TIMEOUT=10
# 文件下载超时秒数，默认60秒
FILE_DOWNLOAD_TIMEOUT=60
# 报告单个远端源文件/模板的最大字节数；仅限制单文件，不限制持久任务积压量。
DOCSENSE_REPORT_MAX_DOWNLOAD_BYTES=536870912
# 文件下载暂存目录默认使用 `${DOCSENSE_RUNTIME_DIR}/llm_downloads`

# ============================================
# 翻译模型配置
# ============================================
# 翻译使用的模型名称，默认使用 Qwen3-4B-Instruct-2507-Q4_K_M
DOCSENSE_TRANSLATION_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M
# 翻译模式：machine 使用 argostranslate 机器翻译；llm 使用 DOCSENSE_TRANSLATION_MODEL 指定的大模型翻译
DOCSENSE_TRANSLATION_MODE=machine
# 机器翻译模型目录
ARGOS_PACKAGES_DIR=D:\DocSense\argos-translate\packages

# ============================================
# OCR 配置
# ============================================
# 处理扫描版 PDF 时，是否自动进行 OCR 识别转换为 Markdown
DOCSENSE_OCR_ENABLED=true
# OCR 识别的语言，默认中文和英文
DOCSENSE_OCR_LANGUAGES=chi_sim+eng
# OCR 识别的DPI，默认300
DOCSENSE_OCR_DPI=300
# OCR 识别的抽样页数，默认3页
DOCSENSE_OCR_SAMPLE_PAGES=3
# OCR 识别的文本阈值，默认50
DOCSENSE_OCR_TEXT_THRESHOLD=50
# OCR 识别缓存默认使用 `${DOCSENSE_RUNTIME_DIR}/ocr_markdown`
# /llm/analysis 扫描 PDF 预处理引擎：mineru 或 ocr；report 等其他入口仍沿旧 OCR 预处理
DOCSENSE_ANALYSIS_SCANNED_PDF_ENGINE=mineru
# MinerU 缓存默认使用 `${DOCSENSE_RUNTIME_DIR}/mineru_markdown`
# MinerU 解析语言，默认中文
DOCSENSE_MINERU_LANG=ch
# 可选：复用外部 MinerU API；为空时沿本地 MinerU API 启动方式
DOCSENSE_MINERU_API_URL=
# Tesseract 语言包目录（如果 Tesseract 未正确安装或找不到语言包时需要手动指定）
TESSDATA_PREFIX=

# 任务库、知识库和对话库均默认保存在 DOCSENSE_RUNTIME_DIR 根目录

# ============================================
# Mock Callback Server 配置
# ============================================
# 模拟甲方回调接口的监听地址和端口
MOCK_CALLBACK_HOST=127.0.0.1 #使用docker的时候要改成0.0.0.0
MOCK_CALLBACK_PORT=9000

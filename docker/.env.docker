# ==============================================================================
# DocSense Docker 环境变量
# ==============================================================================
# 使用方法：填写下方标注【必填】的项，其他项保持默认即可。
#
# 注意：ANYTHINGLLM_BASE_URL 和 OLLAMA_HOST 已在 docker-compose.yml 的
#       environment 中设置为 Docker 内部网络地址，此处无需重复配置。
# ==============================================================================

# ── AnythingLLM 配置 ─────────────────────────────────────────
# 【必填】AnythingLLM 的 API Key
# 首次部署时，先启动服务完成 AnythingLLM 初始设置，获取 API Key 后填入此处，
# 然后执行 docker compose restart docsense 使其生效。
ANYTHINGLLM_API_KEY=

# 请求超时（秒）（可选）
ANYTHINGLLM_TIMEOUT=
# AnythingLLM storage 根目录（Docker 环境下由容器管理，一般不需要设置）
ANYTHINGLLM_STORAGE_ROOT=/anythingllm-storage

# ── APP 配置 ─────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=5001
APP_DEBUG=false

# ── LLM 知识抽取模式配置 ─────────────────────────────────────
# /llm/analysis 默认使用有界 Top-K 两阶段分类与字段抽取。
# 如需回滚，优先将分类模式改为 topk_single；legacy 仅适用于不超过 128
# 个候选且完整 Prompt 不超过 32000 字符的小树。
DOCSENSE_ANALYSIS_CLASSIFICATION_MODE=topk_two_stage
# scope_guard 禁止文件名单源硬覆盖最终分类；legacy 恢复旧约束。
DOCSENSE_ANALYSIS_FILENAME_CONSTRAINT_MODE=scope_guard
# scope_guard 启用经双源确认的数据标准正文分类保护；legacy 关闭保护。
DOCSENSE_ANALYSIS_DATA_STANDARD_MODE=scope_guard
# enforce 默认启用严格双证据装备身份受限重选；off 可即时回滚。
DOCSENSE_ANALYSIS_IDENTITY_RESELECT_MODE=enforce

# ── 文件分析 Dispatcher（1F-5A 内部运行链）─────────────────
# 当前仅支持 SQLite single_instance。公开 /llm/analysis 与 file /llm/check-task
# 尚未切换到该链路；禁止把此配置误解为可靠队列或多实例 Worker 开关。
DOCSENSE_ANALYSIS_RUNTIME_MODE=single_instance
DOCSENSE_ANALYSIS_DISPATCH_SCAN_INTERVAL_SECONDS=1
DOCSENSE_ANALYSIS_DISPATCH_BATCH_SIZE=50
# accepted 领取前的基础设施错误采用持久化指数退避，避免坏任务热循环。
DOCSENSE_ANALYSIS_DISPATCH_RETRY_BASE_SECONDS=5
DOCSENSE_ANALYSIS_DISPATCH_RETRY_MAX_SECONDS=300
DOCSENSE_ANALYSIS_RESOURCE_SWEEP_INTERVAL_SECONDS=30
DOCSENSE_ANALYSIS_RESOURCE_SWEEP_BATCH_SIZE=50
# RAG close 的持久恢复保护期；当前活跃 Worker 优先，超期仅隔离且不重放远端删除。
DOCSENSE_ANALYSIS_RESOURCE_CLOSE_RUNNING_GRACE_SECONDS=300
DOCSENSE_ANALYSIS_RUNNING_ALERT_SECONDS=30
DOCSENSE_ANALYSIS_STOP_TIMEOUT_SECONDS=5
# 租约必须严格大于 HTTP 超时加内部安全余量；非法值在容器装配前失败。
DOCSENSE_ANALYSIS_CALLBACK_HTTP_TIMEOUT_SECONDS=10
DOCSENSE_ANALYSIS_CALLBACK_LEASE_SECONDS=30

# ── 武器谱固定策略与生产门禁 ─────────────────────────────────
# Weaponry 新链固定 file_aggregate_v1，不再提供运行时模式选择器。旧环境若仍残留
# WEAPONRY_ANALYSE_MODE=2，Loader 仅作迁移兼容；值 1 或其他值会在副作用前拒绝。
# 【生产必填】四类指纹必须描述当前实际部署能力，禁止使用 test/unknown 占位值。
DOCSENSE_WEAPONRY_PROVIDER_FINGERPRINT=
DOCSENSE_WEAPONRY_EMBEDDING_FINGERPRINT=
DOCSENSE_WEAPONRY_DOCUMENT_PROCESSING_FINGERPRINT=
DOCSENSE_WEAPONRY_EXTRACTION_MODEL_FINGERPRINT=
DOCSENSE_WEAPONRY_PRODUCTION_ATTESTATION_PATH=/app/runtime/weaponry-production-attestation.json
# Docker 生产模式下证明缺失、篡改或过期会在组合根构造阶段拒绝启动。
DOCSENSE_WEAPONRY_REQUIRE_PRODUCTION_GATE=true

# ── 文件存储配置 ─────────────────────────────────────────────
DOCSENSE_RUNTIME_DIR=/app/runtime
DOCSENSE_MAX_CONTENT_LENGTH=524288000

# ── LLM 集成配置 ─────────────────────────────────────────────
# 甲方业务系统回调地址（如不需要回调可留空）
CALLBACK_URL=
CALLBACK_TIMEOUT=10
FILE_DOWNLOAD_TIMEOUT=60

# ── 翻译模型配置 ─────────────────────────────────────────────
DOCSENSE_TRANSLATION_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M

# ── OCR 配置 ─────────────────────────────────────────────────
DOCSENSE_OCR_ENABLED=true
DOCSENSE_OCR_LANGUAGES=chi_sim+eng
DOCSENSE_OCR_DPI=300
DOCSENSE_OCR_SAMPLE_PAGES=3
DOCSENSE_OCR_TEXT_THRESHOLD=50
TESSDATA_PREFIX=

# ── 宿主机端口映射（可选，用于避免与现有服务的端口冲突）─────
# 在 docker-compose.yml 中通过 ${变量名:-默认值} 引用。
# 如果离线机器上已有 Ollama/AnythingLLM 占用了默认端口，取消注释并修改：
# OLLAMA_HOST_PORT=21434
# ANYTHINGLLM_HOST_PORT=13001
# DOCSENSE_HOST_PORT=15001

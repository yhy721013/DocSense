        "table": "callback_delivery_guards",
        "column": "state",
        "operator": "in",
        "values": ["sending", "outcome_unknown"]
      },
      {
        "id": "report_resource_not_cleaned",
        "category": "resource_or_cleanup",
        "table": "report_resource_records",
        "column": "state",
        "operator": "not_in",

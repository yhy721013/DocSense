{
  "schemaVersion": 1,
  "implementationGate": "route_cutover_completed_at_stage_5",
  "publicContract": {
    "chatEndpoint": "POST /llm/chat",
    "historyEndpoint": "GET /llm/chat/history",
    "selectorMode": "exactly_one_by_field_presence",
    "architectureRequestField": "architectureId",
    "filesRequestField": "fileNames",
    "architectureHistoryField": "architectureId",
    "filesHistoryField": "files",
    "historyArchitectureIdJsonType": "number",
    "successContentType": "text/event-stream",
    "errorBodyFields": [
      "error"
    ],
    "sseEventTypes": [
      "chatInfo",
      "textChunk",
      "done",
      "error",
      "aborted"
    ],
    "fileNamesBaselineSha256": "97C4D99DBEBD1F73E85B006B831B135A0594F21582111348E545D88380910611"
  },
  "architectureId": {
    "minimum": 1,
    "maximum": 9223372036854775807,
    "acceptedKinds": [
      "json_integer",
      "ascii_decimal_string"
    ],
    "decimalStringAllowsLeadingZero": true,
    "historyAlwaysUsesJsonNumber": true,
    "rejectedExamples": [
      null,
      true,
      false,
      0,
      -1,
      1.5,
      "",
      " ",
      "+1",
      "-1",
      "1.0",
      "1e3",
      "１",
      [],
      {}
    ]
  },
  "scopeRules": {
    "directFilesOnly": true,
    "includeDescendants": false,
    "initialStableOrder": [
      "file_name ASC",
      "id ASC"
    ],
    "snapshotCreatedOnlyForNewSession": true,
    "existingSessionRequeriesCatalog": false,
    "existingSessionReusesScopeHead": true,
    "sessionModeImmutable": true,
    "boundArchitectureIdImmutable": true,
    "workerLoadsScopeByRunId": true,
    "historyExpandsSnapshotMembers": false
  },
  "selectionModes": [
    "architecture_initial",
    "architecture_reuse"
  ],
  "errors": [
    {
      "id": "architecture_id_present_but_null",
      "status": 400,
      "text": "architectureId不能为空"
    },
    {
      "id": "both_selectors_absent",
      "status": 400,
      "text": "fileNames必须为数组"
    },
    {
      "id": "architecture_id_invalid",
      "status": 400,
      "text": "architectureId必须为1到9223372036854775807之间的正整数"
    },
    {
      "id": "selector_conflict",
      "status": 400,
      "text": "architectureId与fileNames不能同时传入"
    },
    {
      "id": "catalog_not_found_or_empty",
      "status": 404,
      "text": "architectureId对应类别不存在或没有可用于对话的文件"
    },
    {
      "id": "catalog_invalid",
      "status": 400,
      "text": "architectureId对应类别文件无法形成有效对话范围"
    },
    {
      "id": "scope_limit",
      "status": 400,
      "text": "fileNames超过文件对话数量上限"
    },
    {
      "id": "scope_mode_conflict",
      "status": 409,
      "text": "当前对话的范围模式不匹配"
    },
    {
      "id": "architecture_id_conflict",
      "status": 409,
      "text": "当前对话已绑定其他architectureId"
    },
    {
      "id": "active_stream",
      "status": 409,
      "text": "当前对话已有进行中的流式响应"
    },
    {
      "id": "stream_capacity",
      "status": 429,
      "text": "文件对话并发流已达上限，请稍后重试"
    }
  ],
